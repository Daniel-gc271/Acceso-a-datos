<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<link rel="stylesheet" href="estilos.css">
</head>
<body>
	<form action="Ej5Post_ejemplo" method="post">
		<fieldset>
			<legend>Datos personales</legend>

			<!-- Nombre -->
			<p>
				<label for="nombre">Nombre:</label> <input type="text" name="nombre"
					id="nombre" required>
			</p>

			<!-- Apellidos -->
			<p>
				<label for="apellido1">Primer apellido:</label> <input type="text"
					name="apellido1" id="apellido1" required>
			</p>
			<p>
				<label for="apellido2">Segundo apellido:</label> <input type="text"
					name="apellido2" id="apellido2">
			</p>

			<!-- DNI / NIE -->
			<p>
				<label for="dni">DNI / NIE:</label> <input type="text" name="dni"
					id="dni" placeholder="12345678X">
			</p>

			<!-- Fecha de nacimiento -->
			<p>
				<label for="nacimiento">Fecha de nacimiento:</label> <input
					type="date" name="nacimiento" id="nacimiento">
			</p>

			<!-- Correo electrónico -->
			<p>
				<label for="email">Correo electrónico:</label> <input type="email"
					name="email" id="email" placeholder="ejemplo@correo.com">
			</p>

			<!-- Número de teléfono -->
			<p>
				<label for="telefono">Número de teléfono:</label> <input type="tel"
					name="telefono" id="telefono" placeholder="600123456">
			</p>

		</fieldset>

		<!-- Botones de acción -->
		<button type="submit">Enviar datos</button>
		<button type="reset">Borrar formulario</button>
	</form>
	
<fieldset>
			<legend>Saludar por get</legend>
	<form action="Ej5Post_ejemplo" method="get" >
	<h3>Formulario de Saludo por Idioma</h3>
	
	<!-- Enviamos la variable saludo de forma fija -->
	<input type="hidden" name="saludo" value="Hola">
	
	<p>
		<label for="idioma">Introduce el idioma (es, en, fr, de, it):</label>
		<input type="text" name="idioma" id="idioma" placeholder="Ej: en" required>
	</p>
	
	<button type="submit">Saludar por GET</button>
</form>
</fieldset>



<fieldset>
  <legend>Saludar por post</legend>
  <form action="Ej5Post_ejemplo" method="post">
    <h3>Formulario de Saludo por Idioma</h3>
	
    <!-- Envolvemos cada opción en un contenedor con clase para controlar el diseño -->
    <p class="fila-radio">
      <input type="radio" id="ingles" name="so" value="Hello World!" checked>
      <label for="ingles">Inglés</label>
    </p>

    <p class="fila-radio">
      <input type="radio" id="español" name="so" value="19 de julio de 2026 campeones del mundo!">
      <label for="español">Español</label>
    </p>

    <p class="fila-radio">
      <input type="radio" id="italiano" name="so" value="Ciao a tutti">
      <label for="italiano">Italiano</label>
    </p>
	
    <p class="fila-radio">
      <input type="radio" id="frances" name="so" value="bonjour le gars">
      <label for="frances">Francés</label>
    </p>
	
    <!-- Añadimos una clase al botón único para que se expanda correctamente -->
    <button type="submit" class="btn-unico">Saludar por POST</button>
  </form>
  
  
  
